<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Target Name="ILRepacker" AfterTargets="Build">
        <ItemGroup>
            <InputAssemblies Include="$(TargetPath)" />
            <InputAssemblies Include="$(LibsDir)\ServerSync.dll" />
        </ItemGroup>
        <ILRepack Parallel="true" Internalize="true" InputAssemblies="@(InputAssemblies)" LibraryPath="$(BepInExDir);$(ManagedDir);$(LibsDir)" TargetKind="Dll" OutputFile="$(TargetPath)" />
    </Target>
</Project>